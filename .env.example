# Google OAuth client IDs for expo-auth-session's Google sign-in
# (src/state/auth.tsx, src/firebase/config.ts) — Task 13.
#
# These are NOT the Firebase Web apiKey (that one is hardcoded in
# src/firebase/config.ts — it's a public project identifier, not a secret,
# same as the web app). These identify THIS app to Google's OAuth server
# and are created in Google Cloud Console under the `xdev-asia` Firebase
# project: APIs & Services -> Credentials -> Create Credentials -> OAuth
# client ID, one per platform you want signed in on.
#
# Like the Firebase apiKey, an "iOS"/"Android" OAuth client ID is a public
# identifier — Google does not issue a client SECRET for those types, only
# for "Web application" clients (see task-13-report.md's measurement of the
# equivalent question for GitHub, which is why GitHub sign-in was dropped).
# Safe to commit real values here once created; this file just isn't
# populated yet because no one has created them.
#
# Until these are set, the Google sign-in button in Settings stays
# hidden/disabled (src/state/auth.tsx's `isGoogleConfigured`) instead of
# failing with an opaque provider error.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
